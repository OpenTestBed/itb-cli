<?xml version="1.0" encoding="UTF-8"?>
<testcase id="tc-server-004-generate-and-validate-a-belgian-patient"
          xmlns="http://www.gitb.com/tdl/v1/"
          xmlns:gitb="http://www.gitb.com/core/v1/">
  <metadata>
    <gitb:name>tc-server-004 Generate and validate a Belgian patient</gitb:name>
    <gitb:version>1.0</gitb:version>
    <gitb:description>Server handles Belgian allergy resources</gitb:description>
  </metadata>

  <actors>
    <gitb:actor id="FHIRServer" role="SUT"/>
    <gitb:actor id="Client" role="SIMULATED"/>
    <gitb:actor id="Validator" role="SIMULATED"/>
  </actors>

  <variables>
    <var name="FHIRServerDataPool" type="string">
      <value>default</value>
    </var>
    <var name="loadIgBody" type="string"/>
    <var name="fhirpathBody" type="string"/>
    <var name="fhirpathResult" type="string"/>
    <var name="lastRequest" type="map"/>
    <var name="FHIRServerBase" type="string"/>
    <var name="ClientBase" type="string"/>
    <var name="fhirValidatorHeaders" type="map"/>
    <var name="loadIgTplParams" type="map"/>
    <var name="patientMappings" type="string"/>
    <var name="patients" type="string"/>
    <var name="fhirpathTplParams" type="map"/>
    <var name="ValidatorBase" type="string"/>
    <var name="bePatient" type="string"/>
    <var name="FHIRValidatorBase" type="string"/>
  </variables>

  <steps stopOnError="true">
    <assign to="FHIRServerBase">&quot;http://localhost:8080/fhir&quot;</assign>
    <assign to="ClientBase">&quot;http://localhost:9000/fhir&quot;</assign>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="loadIgTplParams{ig}">&quot;hl7.fhir.be.allergy#1.1.2&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="loadIgBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;loadIG&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;ig&quot;, &quot;value&quot;: &quot;${ig}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$loadIgTplParams</input>
    </process>
    <send id="lastRequest" desc="Load IG via IGManager" handler="HttpMessagingV2" from="FHIRServer" to="Validator">
      <input name="uri">concat($ValidatorBase, &quot;/itb/igManager/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$loadIgBody</input>
    </send>
    <verify handler="NumberValidator" desc="IGManager.loadIG returned HTTP 200">
      <input name="actualnumber">$lastRequest{response}{status}</input>
      <input name="expectednumber">&quot;200&quot;</input>
    </verify>
    <assign to="patientMappings" append="true">'{&quot;path&quot;:&quot;Patient.identifier:SSIN&quot;,&quot;part&quot;:&quot;system&quot;,&quot;expression&quot;:&quot;\'https://www.ehealth.fgov.be/standards/fhir/core/NamingSystem/ssin\'&quot;}'</assign>
    <assign to="patientMappings" append="true">'{&quot;path&quot;:&quot;Patient.identifier:SSIN&quot;,&quot;part&quot;:&quot;value&quot;,&quot;expression&quot;:&quot;column(\'ssin\')&quot;}'</assign>
    <assign to="patientMappings" append="true">'{&quot;path&quot;:&quot;Patient.name&quot;,&quot;part&quot;:&quot;family&quot;,&quot;expression&quot;:&quot;column(\'family\')&quot;}'</assign>
    <assign to="patientMappings" append="true">'{&quot;path&quot;:&quot;Patient.name&quot;,&quot;part&quot;:&quot;given&quot;,&quot;expression&quot;:&quot;column(\'given\')&quot;}'</assign>
    <assign to="patientMappings" append="true">'{&quot;path&quot;:&quot;Patient.gender&quot;,&quot;part&quot;:&quot;&quot;,&quot;expression&quot;:&quot;column(\'gender\')&quot;}'</assign>
    <assign to="patientMappings" append="true">'{&quot;path&quot;:&quot;Patient.birthDate&quot;,&quot;part&quot;:&quot;&quot;,&quot;expression&quot;:&quot;column(\'birthDate\')&quot;}'</assign>
    <assign to="patients" append="true">'{&quot;0&quot;:&quot;$&quot;,&quot;1&quot;:&quot;r&quot;,&quot;2&quot;:&quot;o&quot;,&quot;3&quot;:&quot;w&quot;}'</assign>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="fhirpathTplParams{resource}">$bePatient</assign>
    <assign to="fhirpathTplParams{expression}">&quot;Patient.name.family&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="fhirpathBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;evaluate&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;content&quot;, &quot;value&quot;: &quot;${resource?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;expression&quot;, &quot;value&quot;: &quot;${expression?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$fhirpathTplParams</input>
    </process>
    <send id="lastRequest" desc="Evaluate FHIRPath expression" handler="HttpMessagingV2" from="FHIRServer">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/fhirPath/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$fhirpathBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="fhirpathResult">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/output/0/value&quot;</input>
    </process>
    <verify handler="StringValidator" desc="FHIRPath result matches expected value">
      <input name="actualstring">$fhirpathResult</input>
      <input name="expectedstring">&quot;Pansen&quot;</input>
    </verify>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="fhirpathTplParams{resource}">$bePatient</assign>
    <assign to="fhirpathTplParams{expression}">&quot;Patient.name.given&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="fhirpathBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;evaluate&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;content&quot;, &quot;value&quot;: &quot;${resource?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;expression&quot;, &quot;value&quot;: &quot;${expression?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$fhirpathTplParams</input>
    </process>
    <send id="lastRequest" desc="Evaluate FHIRPath expression" handler="HttpMessagingV2" from="FHIRServer">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/fhirPath/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$fhirpathBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="fhirpathResult">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/output/0/value&quot;</input>
    </process>
    <verify handler="StringValidator" desc="FHIRPath result matches expected value">
      <input name="actualstring">$fhirpathResult</input>
      <input name="expectedstring">&quot;Jan&quot;</input>
    </verify>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="fhirpathTplParams{resource}">$bePatient</assign>
    <assign to="fhirpathTplParams{expression}">&quot;Patient.identifier.where(system='https://www.ehealth.fgov.be/standards/fhir/core/NamingSystem/ssin').value&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="fhirpathBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;evaluate&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;content&quot;, &quot;value&quot;: &quot;${resource?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;expression&quot;, &quot;value&quot;: &quot;${expression?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$fhirpathTplParams</input>
    </process>
    <send id="lastRequest" desc="Evaluate FHIRPath expression" handler="HttpMessagingV2" from="FHIRServer">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/fhirPath/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$fhirpathBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="fhirpathResult">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/output/0/value&quot;</input>
    </process>
    <verify handler="StringValidator" desc="FHIRPath result matches expected value">
      <input name="actualstring">$fhirpathResult</input>
      <input name="expectedstring">&quot;79121539875&quot;</input>
    </verify>
  </steps>

  <output>
    <success>
      <default>"Test case completed successfully."</default>
    </success>
    <failure>
      <default>"Test case failed. Check step reports and logs."</default>
    </failure>
  </output>
</testcase>