<?xml version="1.0" encoding="UTF-8"?>
<testsuite id="fhirpath-expression-evaluation-and-assertions"
           xmlns="http://www.gitb.com/tdl/v1/"
           xmlns:gitb="http://www.gitb.com/core/v1/">
  <metadata>
    <gitb:name>FHIRPath expression evaluation and assertions</gitb:name>
    <gitb:version>1.0</gitb:version>
    <gitb:description>A generated resource is a FHIR resource, so FHIRPath can be evaluated on it directly with `at &quot;…&quot;`; the same expressions bind values with `extract`.</gitb:description>
  </metadata>

  <actors>
    <gitb:actor id="Client">
      <gitb:name>Client</gitb:name>
    </gitb:actor>
    <gitb:actor id="FHIRValidator">
      <gitb:name>FHIRValidator</gitb:name>
      <gitb:desc>Endpoint: http://fhir-validator:8081</gitb:desc>
    </gitb:actor>
  </actors>

  <testcase id="fhirpath-checks-on-generated-data"/>

</testsuite>