    <process handler="TemplateProcessor" operation="process" output="opsJson">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'${accum}&lt;#if accum?ends_with(&quot;[&quot;)&gt;&lt;#else&gt;,&lt;/#if&gt;{&quot;op&quot;:&quot;${op}&quot;,&quot;path&quot;:&quot;${path}&quot;&lt;#if op != &quot;remove&quot;&gt;&lt;#if value?has_content&gt;,&quot;value&quot;:&quot;${value}&quot;&lt;#else&gt;,&quot;parts&quot;:[{&quot;name&quot;:&quot;system&quot;,&quot;value&quot;:&quot;${system}&quot;},{&quot;name&quot;:&quot;code&quot;,&quot;value&quot;:&quot;${code}&quot;}]&lt;/#if&gt;&lt;/#if&gt;}'</input>
      <input name="parameters">$opTplParams</input>
    </process>
    <assign to="closeOpsTplParams{accum}">$opsJson</assign>
    <process handler="TemplateProcessor" operation="process" output="opsJson">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'${accum}]'</input>
      <input name="parameters">$closeOpsTplParams</input>
    </process>
    <assign to="modifyTplParams{resource}">$patient2</assign>
    <assign to="modifyTplParams{operations}">$opsJson</assign>
    <assign to="modifyTplParams{profile}">&quot;http://hl7.org/fhir/StructureDefinition/Patient&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="modifyBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;modify&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;resource&quot;, &quot;value&quot;: &quot;${resource?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;operations&quot;, &quot;value&quot;: &quot;${operations?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;profile&quot;, &quot;value&quot;: &quot;${profile}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;enforce&quot;, &quot;value&quot;: &quot;true&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$modifyTplParams</input>
    </process>
    <send id="lastRequest" desc="Modify resource (enforce against profile)" handler="HttpMessagingV2" from="Client">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/testdata/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$modifyBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="patient2">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/output/0/value&quot;</input>
    </process>
    <process handler="JsonPointerProcessor" operation="process" output="modificationOutcome">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/output/1/value&quot;</input>
    </process>
    <assign to="summarizeTplParams{outcome}">$modificationOutcome</assign>
    <process handler="TemplateProcessor" operation="process" output="summarizeBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;summarize&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;outcome&quot;, &quot;value&quot;: &quot;${outcome?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$summarizeTplParams</input>
    </process>
    <send id="summarizeRequest" desc="Summarise modification OperationOutcome" handler="HttpMessagingV2" from="Client">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/validationResults/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$summarizeBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="modificationErrors">
      <input name="content">$summarizeRequest{response}{body}</input>
      <input name="pointer">&quot;/output/0/value&quot;</input>
    </process>
    <verify handler="StringValidator" desc="Modification produced no validation errors">
      <input name="actualstring">$modificationErrors</input>
      <input name="expectedstring">&quot;0&quot;</input>
    </verify>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="assertTplParams{resource}">$patient2</assign>
    <assign to="assertTplParams{expression}">&quot;Patient.gender = 'female'&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="assertBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;input&quot;: [ { &quot;name&quot;: &quot;contentToValidate&quot;, &quot;value&quot;: &quot;${resource?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;expression&quot;, &quot;value&quot;: &quot;${expression?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$assertTplParams</input>
    </process>
    <send id="lastRequest" desc="FHIRPath assertion" handler="HttpMessagingV2" from="Client">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/fhirPathAssertion/validate&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$assertBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="assertResult">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/result&quot;</input>
    </process>
    <verify handler="StringValidator" desc="FHIRPath assertion succeeded">
      <input name="actualstring">$assertResult</input>
      <input name="expectedstring">&quot;SUCCESS&quot;</input>
    </verify>
  </steps>

  <output>
    <success>
      <default>"Test case completed successfully."</default>
    </success>
    <failure>
      <default>"Test case failed. Check step reports and logs."</default>
    </failure>
  </output>
</testcase>