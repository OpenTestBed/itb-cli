<?xml version="1.0" encoding="UTF-8"?>
<testsuite id="fhir-validator-modify-operation"
           xmlns="http://www.gitb.com/tdl/v1/"
           xmlns:gitb="http://www.gitb.com/core/v1/">
  <metadata>
    <gitb:name>FHIR Validator modify operation</gitb:name>
    <gitb:version>1.0</gitb:version>
    <gitb:description>Exercises the /itb/testdata modify operation: takes an existing resource and applies set / add / remove operations to it, optionally re-validating the modified resource against a profile.</gitb:description>
  </metadata>

  <actors>
    <gitb:actor id="Client">
      <gitb:name>Client</gitb:name>
    </gitb:actor>
    <gitb:actor id="FHIRValidator">
      <gitb:name>FHIRValidator</gitb:name>
      <gitb:desc>Endpoint: http://fhir-validator:8081</gitb:desc>
    </gitb:actor>
  </actors>

  <testcase id="modify-resource-exercise-set-add-remove-and-enforced-modification"/>

</testsuite>