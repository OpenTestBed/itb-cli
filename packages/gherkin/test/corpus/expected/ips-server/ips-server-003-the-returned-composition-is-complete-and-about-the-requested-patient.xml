    </process>
    <send id="lastRequest" desc="FHIRPath Bundle.entry.resource.ofType(Composition).date.exists()" handler="HttpMessagingV2" from="IPSServer" to="FHIRValidator">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/fhirPath/process&quot;)</input>
