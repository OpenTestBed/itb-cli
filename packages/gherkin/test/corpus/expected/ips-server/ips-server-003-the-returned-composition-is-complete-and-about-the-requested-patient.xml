    <assign to="fhirpathTplParams{expression}">&quot;Bundle.entry.resource.ofType(Patient).identifier.where(value='$patientIdentifier').exists() or Bundle.entry.resource.ofType(Patient).exists()&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="fhirpathBody">
