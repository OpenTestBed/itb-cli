    <send id="lastRequest" desc="PUT /DocumentReference/otb-mhd-probe-001" handler="HttpMessagingV2" from="DocumentSource" to="DocumentResponder">
      <input name="uri">concat($DocumentResponderBase, &quot;/DocumentReference/otb-mhd-probe-001&quot;)</input>
