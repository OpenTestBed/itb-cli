<?xml version="1.0" encoding="UTF-8"?>
<testcase id="mhd-peer-001-the-description-can-be-updated-and-nothing-else-moves"
          xmlns="http://www.gitb.com/tdl/v1/"
          xmlns:gitb="http://www.gitb.com/core/v1/">
  <metadata>
    <gitb:name>mhd-peer-001 the description can be updated and nothing else moves</gitb:name>
    <gitb:version>1.0</gitb:version>
    <gitb:description>MHD stateful peer — seed, act, verify against a real server</gitb:description>
  </metadata>

  <actors>
    <gitb:actor id="DocumentResponder" role="SUT"/>
    <gitb:actor id="DocumentSource" role="SIMULATED"/>
    <gitb:actor id="FHIRValidator" role="SIMULATED"/>
  </actors>

  <variables>
    <var name="fhirpathBody" type="string"/>
    <var name="pathValue" type="string"/>
    <var name="lastRequest" type="map"/>
    <var name="DocumentResponderBase" type="string"/>
    <var name="FHIRValidatorBase" type="string"/>
    <var name="jsonHeaders" type="map"/>
    <var name="seeded" type="string"/>
    <var name="sigStatus" type="string"/>
    <var name="fhirValidatorHeaders" type="map"/>
    <var name="fhirpathTplParams" type="map"/>
    <var name="updated" type="string"/>
  </variables>

  <steps stopOnError="true">
    <assign to="DocumentResponderBase">&quot;https://hapi.fhir.org/baseR4&quot;</assign>
    <assign to="FHIRValidatorBase">&quot;http://fhir-validator:8081&quot;</assign>
    <assign to="jsonHeaders{Accept}">&quot;application/fhir+json&quot;</assign>
    <assign to="jsonHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="jsonHeaders{Accept}">&quot;application/json&quot;</assign>
    <send id="lastRequest" desc="PUT /DocumentReference/otb-mhd-probe-001" handler="HttpMessagingV2" from="DocumentSource" to="DocumentResponder">
      <input name="uri">concat($DocumentResponderBase, &quot;/DocumentReference/otb-mhd-probe-001&quot;)</input>
      <input name="method">&quot;PUT&quot;</input>
      <input name="headers">$jsonHeaders</input>
      <input name="body">'{
      &quot;resourceType&quot;: &quot;DocumentReference&quot;,
      &quot;id&quot;: &quot;otb-mhd-probe-001&quot;,
      &quot;status&quot;: &quot;current&quot;,
      &quot;description&quot;: &quot;Original description for -MedicationCard&quot;,
      &quot;content&quot;: [{ &quot;attachment&quot;: { &quot;contentType&quot;: &quot;application/pdf&quot; } }]
    }'</input>
    </send>
    <assign to="jsonHeaders{Accept}">&quot;application/json&quot;</assign>
    <send id="lastRequest" desc="GET /DocumentReference/otb-mhd-probe-001" handler="HttpMessagingV2" from="DocumentSource" to="DocumentResponder">
