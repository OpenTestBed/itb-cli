<?xml version="1.0" encoding="UTF-8"?>
<testcase id="ips-consumer-025-observation-pregnancy-status-ips-the-consumer-handles-7-elements-and-displays-6"
          xmlns="http://www.gitb.com/tdl/v1/"
          xmlns:gitb="http://www.gitb.com/core/v1/">
  <metadata>
    <gitb:name>ips-consumer-025 Observation Pregnancy - Status (IPS) — the Consumer handles 7 elements and displays 6</gitb:name>
    <gitb:version>1.0</gitb:version>
    <gitb:description>IPS Consumer — obligations of hl7.fhir.uv.ips 2.0.1</gitb:description>
  </metadata>

  <actors>
    <gitb:actor id="Consumer" role="SUT"/>
    <gitb:actor id="Tester" role="SIMULATED"/>
    <gitb:actor id="FHIRValidator" role="SIMULATED"/>
  </actors>

  <variables>
    <var name="handledObservationpregnancystatusEvidence" type="binary"/>
    <var name="handledObservationpregnancystatusEvidence_note" type="string">
      <value>&quot;&quot;</value>
    </var>
    <var name="displayedObservationpregnancystatusEvidence" type="binary"/>
    <var name="displayedObservationpregnancystatusEvidence_note" type="string">
      <value>&quot;&quot;</value>
    </var>
    <var name="loadIgBody" type="string"/>
    <var name="conformBody" type="string"/>
    <var name="validationErrors" type="string"/>
    <var name="validationWarnings" type="string"/>
    <var name="validationSeverity" type="string"/>
    <var name="validationOutcome" type="string"/>
    <var name="dgFpBody" type="string"/>
    <var name="conformanceErrors" type="string"/>
    <var name="lastRequest" type="map"/>
    <var name="FHIRValidatorBase" type="string"/>
    <var name="fhirValidatorHeaders" type="map"/>
    <var name="loadIgTplParams" type="map"/>
    <var name="jsonHeaders" type="map"/>
    <var name="ips" type="string"/>
    <var name="conformHeaders" type="map"/>
    <var name="conformTplParams" type="map"/>
    <var name="dgFpParams" type="map"/>
    <var name="confirmed" type="map"/>
  </variables>

  <steps stopOnError="true">
    <assign to="FHIRValidatorBase">&quot;http://fhir-validator:8081&quot;</assign>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="loadIgTplParams{ig}">&quot;hl7.fhir.uv.ips#2.0.1&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="loadIgBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;loadIG&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;ig&quot;, &quot;value&quot;: &quot;${ig?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$loadIgTplParams</input>
    </process>
    <send id="lastRequest" desc="Load IG hl7.fhir.uv.ips#2.0.1" handler="HttpMessagingV2" from="Consumer" to="FHIRValidator">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/igManager/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$loadIgBody</input>
    </send>
    <verify handler="NumberValidator" desc="IG hl7.fhir.uv.ips#2.0.1 loaded (HTTP 200)">
      <input name="actualnumber">$lastRequest{response}{status}</input>
      <input name="expectednumber">&quot;200&quot;</input>
    </verify>
    <assign to="jsonHeaders{Accept}">&quot;application/json&quot;</assign>
    <send id="lastRequest" desc="GET https://hl7.org/fhir/uv/ips/Bundle-bundle-ips-all-sections.json" handler="HttpMessagingV2" from="Tester">
      <input name="uri">&quot;https://hl7.org/fhir/uv/ips/Bundle-bundle-ips-all-sections.json&quot;</input>
      <input name="method">&quot;GET&quot;</input>
      <input name="headers">$jsonHeaders</input>
    </send>
    <assign to="ips">$lastRequest{response}{body}</assign>
    <assign to="conformHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="conformHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="conformTplParams{resource}">$ips</assign>
    <assign to="conformTplParams{profile}">&quot;http://hl7.org/fhir/uv/ips/StructureDefinition/Bundle-uv-ips&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="conformBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;input&quot;: [ { &quot;name&quot;: &quot;contentToValidate&quot;, &quot;value&quot;: &quot;${resource?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;profiles&quot;, &quot;value&quot;: &quot;${profile?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$conformTplParams</input>
    </process>
    <send id="lastRequest" desc="Validate $ips against http://hl7.org/fhir/uv/ips/StructureDefinition/Bundle-uv-ips" handler="HttpMessagingV2" from="Consumer" to="FHIRValidator">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/fhir/validate&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$conformHeaders</input>
      <input name="body">$conformBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="validationErrors">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/context/0/value&quot;</input>
    </process>
    <process handler="JsonPointerProcessor" operation="process" output="validationWarnings">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/context/1/value&quot;</input>
    </process>
    <process handler="JsonPointerProcessor" operation="process" output="validationSeverity">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/context/3/value&quot;</input>
    </process>
    <process handler="JsonPointerProcessor" operation="process" output="validationOutcome">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/context/4/value&quot;</input>
    </process>
    <assign to="dgFpParams{resource}">$validationOutcome</assign>
    <assign to="dgFpParams{expression}">&quot;issue.where(severity = 'error').count() - issue.where(severity = 'error' and details.text.contains('matching slice is required')).count()&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="dgFpBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;evaluate&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;content&quot;, &quot;value&quot;: &quot;${resource?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;expression&quot;, &quot;value&quot;: &quot;${expression?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$dgFpParams</input>
    </process>
    <send id="lastRequest" desc="Count real errors, ignoring &quot;matching slice is required&quot;" handler="HttpMessagingV2" from="Consumer" to="FHIRValidator">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/fhirPath/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$conformHeaders</input>
      <input name="body">$dgFpBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="conformanceErrors">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/output/0/value&quot;</input>
    </process>
    <log>concat(&quot;conforms: &quot;, $validationErrors, &quot; errors reported, &quot;, $conformanceErrors, &quot; counted after ignoring 'matching slice is required'&quot;)</log>
    <verify handler="StringValidator" desc="$ips conforms to http://hl7.org/fhir/uv/ips/StructureDefinition/Bundle-uv-ips (ignoring slicing errors)">
      <input name="actualstring">$conformanceErrors</input>
      <input name="expectedstring">&quot;0&quot;</input>
    </verify>
    <interact id="inform" desc="Import this International Patient Summary for Patricia JORDANA into the system under test, then answer the questions that follow." inputTitle="Instruction for Consumer" with="Consumer">
      <instruct desc="Instruction" name="message" forceDisplay="true">&quot;Import this International Patient Summary for Patricia JORDANA into the system under test, then answer the questions that follow.&quot;</instruct>
      <instruct desc="Content" name="content">$ips</instruct>
    </interact>
    <interact id="evidence" desc="Evidence: the import of the Observation resources of this kind completing without error (import log or screenshot)" inputTitle="Evidence: the import of the Observation resources of this kind completing without error (import log or screenshot)" with="Consumer">
      <instruct desc="Demonstrate on the system under test: the import of the Observation resources of this kind completing without error (import log or screenshot). Then attach a screenshot, export or log that shows it." name="instruction"/>
      <request desc="Evidence file (screenshot, export or log) for: the import of the Observation resources of this kind completing without error (import log or screenshot)" name="handledObservationpregnancystatusEvidence" inputType="UPLOAD" required="true">$handledObservationpregnancystatusEvidence</request>
      <request desc="Note (optional): where it is shown, or why it cannot be" name="handledObservationpregnancystatusEvidence_note" inputType="TEXT" required="false">$handledObservationpregnancystatusEvidence_note</request>
    </interact>
    <log>concat(&quot;Evidence submitted for: the import of the Observation resources of this kind completing without error (import log or screenshot) — note: &quot;, $handledObservationpregnancystatusEvidence_note)</log>
    <interact id="confirm" desc="For the Observation resources of this kind: is each of these accepted?" inputTitle="For the Observation resources of this kind: is each of these accepted?" with="Consumer">
      <instruct desc="For the Observation resources of this kind, choose for each item below whether it is accepted. Leave nothing unanswered." name="instruction"/>
      <request desc="code — Pregnancy status" name="confirmed_1" inputType="SELECT_SINGLE" required="true" options="yes,no" optionLabels="accepted,not accepted">$confirmed{1}</request>
      <request desc="subject — Patient/d174bd1a-b368-41e6-83a2-af77f…" name="confirmed_2" inputType="SELECT_SINGLE" required="true" options="yes,no" optionLabels="accepted,not accepted">$confirmed{2}</request>
      <request desc="subject.reference — Patient/d174bd1a-b368-41e6-83a2-af77f…" name="confirmed_3" inputType="SELECT_SINGLE" required="true" options="yes,no" optionLabels="accepted,not accepted">$confirmed{3}</request>
      <request desc="effective[x] — 2020-01-10" name="confirmed_4" inputType="SELECT_SINGLE" required="true" options="yes,no" optionLabels="accepted,not accepted">$confirmed{4}</request>
      <request desc="value[x]:valueCodeableConcept — Not Pregnant" name="confirmed_5" inputType="SELECT_SINGLE" required="true" options="yes,no" optionLabels="accepted,not accepted">$confirmed{5}</request>
      <request desc="hasMember — " name="confirmed_6" inputType="SELECT_SINGLE" required="true" options="yes,no" optionLabels="accepted,not accepted">$confirmed{6}</request>
      <request desc="hasMember.reference — " name="confirmed_7" inputType="SELECT_SINGLE" required="true" options="yes,no" optionLabels="accepted,not accepted">$confirmed{7}</request>
    </interact>
    <verify handler="StringValidator" desc="code is accepted for the Observation resources of this kind">
      <input name="actualstring">$confirmed{1}</input>
      <input name="expectedstring">&quot;yes&quot;</input>
    </verify>
    <verify handler="StringValidator" desc="subject is accepted for the Observation resources of this kind">
      <input name="actualstring">$confirmed{2}</input>
      <input name="expectedstring">&quot;yes&quot;</input>
    </verify>
    <verify handler="StringValidator" desc="subject.reference is accepted for the Observation resources of this kind">
      <input name="actualstring">$confirmed{3}</input>
      <input name="expectedstring">&quot;yes&quot;</input>
    </verify>
    <verify handler="StringValidator" desc="effective[x] is accepted for the Observation resources of this kind">
      <input name="actualstring">$confirmed{4}</input>
      <input name="expectedstring">&quot;yes&quot;</input>
    </verify>
    <verify handler="StringValidator" desc="value[x]:valueCodeableConcept is accepted for the Observation resources of this kind">
      <input name="actualstring">$confirmed{5}</input>
      <input name="expectedstring">&quot;yes&quot;</input>
    </verify>
    <verify handler="StringValidator" desc="hasMember is accepted for the Observation resources of this kind">
      <input name="actualstring">$confirmed{6}</input>
      <input name="expectedstring">&quot;yes&quot;</input>
    </verify>
    <verify handler="StringValidator" desc="hasMember.reference is accepted for the Observation resources of this kind">
      <input name="actualstring">$confirmed{7}</input>
      <input name="expectedstring">&quot;yes&quot;</input>
    </verify>
    <interact id="inform" desc="Open Patricia JORDANA's summary in the system under test and display the Observation resources of this kind." inputTitle="Instruction for Consumer" with="Consumer">
      <instruct desc="Instruction" name="message" forceDisplay="true">&quot;Open Patricia JORDANA's summary in the system under test and display the Observation resources of this kind.&quot;</instruct>
    </interact>
    <interact id="evidence" desc="Evidence: the Observation resources of this kind displayed (screenshot)" inputTitle="Evidence: the Observation resources of this kind displayed (screenshot)" with="Consumer">
      <instruct desc="Demonstrate on the system under test: the Observation resources of this kind displayed (screenshot). Then attach a screenshot, export or log that shows it." name="instruction"/>
      <request desc="Evidence file (screenshot, export or log) for: the Observation resources of this kind displayed (screenshot)" name="displayedObservationpregnancystatusEvidence" inputType="UPLOAD" required="true">$displayedObservationpregnancystatusEvidence</request>
      <request desc="Note (optional): where it is shown, or why it cannot be" name="displayedObservationpregnancystatusEvidence_note" inputType="TEXT" required="false">$displayedObservationpregnancystatusEvidence_note</request>
    </interact>
    <log>concat(&quot;Evidence submitted for: the Observation resources of this kind displayed (screenshot) — note: &quot;, $displayedObservationpregnancystatusEvidence_note)</log>
    <interact id="confirm" desc="For the Observation resources of this kind: is each of these displayed?" inputTitle="For the Observation resources of this kind: is each of these displayed?" with="Consumer">
      <instruct desc="For the Observation resources of this kind, choose for each item below whether it is displayed. Leave nothing unanswered." name="instruction"/>
      <request desc="code — Pregnancy status" name="confirmed_1" inputType="SELECT_SINGLE" required="true" options="yes,no" optionLabels="displayed,not displayed">$confirmed{1}</request>
      <request desc="subject — Patient/d174bd1a-b368-41e6-83a2-af77f…" name="confirmed_2" inputType="SELECT_SINGLE" required="true" options="yes,no" optionLabels="displayed,not displayed">$confirmed{2}</request>
      <request desc="effective[x] — 2020-01-10" name="confirmed_3" inputType="SELECT_SINGLE" required="true" options="yes,no" optionLabels="displayed,not displayed">$confirmed{3}</request>
      <request desc="value[x]:valueCodeableConcept — Not Pregnant" name="confirmed_4" inputType="SELECT_SINGLE" required="true" options="yes,no" optionLabels="displayed,not displayed">$confirmed{4}</request>
      <request desc="hasMember — " name="confirmed_5" inputType="SELECT_SINGLE" required="true" options="yes,no" optionLabels="displayed,not displayed">$confirmed{5}</request>
      <request desc="hasMember.reference — " name="confirmed_6" inputType="SELECT_SINGLE" required="true" options="yes,no" optionLabels="displayed,not displayed">$confirmed{6}</request>
    </interact>
    <verify handler="StringValidator" desc="code is displayed for the Observation resources of this kind">
      <input name="actualstring">$confirmed{1}</input>
      <input name="expectedstring">&quot;yes&quot;</input>
    </verify>
    <verify handler="StringValidator" desc="subject is displayed for the Observation resources of this kind">
      <input name="actualstring">$confirmed{2}</input>
      <input name="expectedstring">&quot;yes&quot;</input>
    </verify>
    <verify handler="StringValidator" desc="effective[x] is displayed for the Observation resources of this kind">
      <input name="actualstring">$confirmed{3}</input>
      <input name="expectedstring">&quot;yes&quot;</input>
    </verify>
    <verify handler="StringValidator" desc="value[x]:valueCodeableConcept is displayed for the Observation resources of this kind">
      <input name="actualstring">$confirmed{4}</input>
      <input name="expectedstring">&quot;yes&quot;</input>
    </verify>
    <verify handler="StringValidator" desc="hasMember is displayed for the Observation resources of this kind">
      <input name="actualstring">$confirmed{5}</input>
      <input name="expectedstring">&quot;yes&quot;</input>
    </verify>
    <verify handler="StringValidator" desc="hasMember.reference is displayed for the Observation resources of this kind">
      <input name="actualstring">$confirmed{6}</input>
      <input name="expectedstring">&quot;yes&quot;</input>
    </verify>
  </steps>

  <output>
    <success>
      <default>"Test case completed successfully."</default>
    </success>
    <failure>
      <default>"Test case failed. Check step reports and logs."</default>
    </failure>
  </output>
</testcase>