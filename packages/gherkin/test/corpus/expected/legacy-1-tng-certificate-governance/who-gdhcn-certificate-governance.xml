<?xml version="1.0" encoding="UTF-8"?>
<testsuite id="who-gdhcn-certificate-governance"
           xmlns="http://www.gitb.com/tdl/v1/"
           xmlns:gitb="http://www.gitb.com/core/v1/">
  <metadata>
    <gitb:name>WHO GDHCN certificate governance</gitb:name>
    <gitb:version>1.0</gitb:version>
    <gitb:description>Every certificate in a participant's onboarding material must satisfy the governance rules for the role its folder places it in.</gitb:description>
  </metadata>

  <actors>
    <gitb:actor id="Participant">
      <gitb:name>Participant</gitb:name>
    </gitb:actor>
    <gitb:actor id="TNGValidator">
      <gitb:name>TNGValidator</gitb:name>
      <gitb:desc>Endpoint: http://tng-trust-service:8080</gitb:desc>
    </gitb:actor>
  </actors>

  <testcase id="public-key-meets-the-minimum-size-for-its-algorithm"/>
  <testcase id="public-key-algorithm-is-on-the-allow-list"/>
  <testcase id="the-keyusage-extension-is-present-at-all"/>
  <testcase id="tls-end-entity-keyusage"/>
  <testcase id="tls-ca-keyusage"/>
  <testcase id="upload-keyusage"/>
  <testcase id="sca-keyusage"/>
  <testcase id="tls-end-entity-declares-clientauth"/>
  <testcase id="eku-is-not-required-of-the-other-roles"/>
  <testcase id="sca-is-a-ca-with-an-unconstrained-or-zero-path-length"/>
  <testcase id="the-ca-in-a-tls-group-is-a-ca"/>
  <testcase id="end-entity-certificates-are-not-cas"/>
  <testcase id="the-tls-end-entity-is-signed-by-the-ca-beside-it"/>
  <testcase id="a-tls-end-entity-nothing-signs-is-rejected"/>
  <testcase id="subject-common-name-is-populated"/>
  <testcase id="subject-country-is-the-participant-s-own"/>
  <testcase id="validity-is-within-the-limit-for-the-group"/>
  <testcase id="an-sca-does-not-issue-a-dsc-that-outlives-it"/>

</testsuite>