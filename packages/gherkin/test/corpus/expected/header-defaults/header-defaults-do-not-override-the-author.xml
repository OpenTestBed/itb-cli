<?xml version="1.0" encoding="UTF-8"?>
<testsuite id="header-defaults-do-not-override-the-author"
           xmlns="http://www.gitb.com/tdl/v1/"
           xmlns:gitb="http://www.gitb.com/core/v1/">
  <metadata>
    <gitb:name>Header defaults do not override the author</gitb:name>
    <gitb:version>1.0</gitb:version>
    <gitb:description>The HTTP and reply verbs default Content-Type when nothing has set it, and leave it alone when something has.</gitb:description>
  </metadata>

  <actors>
    <gitb:actor id="Server">
      <gitb:name>Server</gitb:name>
      <gitb:desc>Endpoint: https://api.example.org</gitb:desc>
    </gitb:actor>
    <gitb:actor id="Client">
      <gitb:name>Client</gitb:name>
    </gitb:actor>
  </actors>

  <testcase id="an-author-set-content-type-survives-the-post-verb"/>
  <testcase id="nothing-set-so-the-verb-s-json-default-applies"/>
  <testcase id="a-reply-carries-the-challenge-a-refusal-needs"/>
  <testcase id="a-reply-content-type-set-by-the-author-survives-too"/>

</testsuite>