<?xml version="1.0" encoding="UTF-8"?>
<testsuite id="eira-alignment-of-the-national-ehealth-exchange-architecture"
           xmlns="http://www.gitb.com/tdl/v1/"
           xmlns:gitb="http://www.gitb.com/core/v1/">
  <metadata>
    <gitb:name>EIRA alignment of the national eHealth exchange architecture</gitb:name>
    <gitb:version>1.0</gitb:version>
    <gitb:description>The solution architecture for cross-border patient summary exchange must align with the European Interoperability Reference Architecture (EIRA): every building block is typed, the interoperability layers are all present, and the application services realise the digital public service they support.</gitb:description>
  </metadata>

  <actors>
    <gitb:actor id="Architect">
      <gitb:name>Architect</gitb:name>
    </gitb:actor>
    <gitb:actor id="ModelRepo">
      <gitb:name>ModelRepo</gitb:name>
      <gitb:desc>Endpoint: http://archi:8080</gitb:desc>
    </gitb:actor>
    <gitb:actor id="EiraValidator">
      <gitb:name>EiraValidator</gitb:name>
      <gitb:desc>Endpoint: http://eira:8080</gitb:desc>
    </gitb:actor>
  </actors>

  <testcase id="eira-001-the-model-is-eira-conformant"/>
  <testcase id="eira-002-every-interoperability-layer-is-represented"/>
  <testcase id="eira-003-the-patient-summary-service-is-a-typed-digital-public-service"/>
  <testcase id="eira-004-every-application-interface-realises-a-service"/>
  <testcase id="eira-005-the-legal-basis-is-traceable-to-the-technical-layer"/>

</testsuite>