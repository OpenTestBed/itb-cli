<?xml version="1.0" encoding="UTF-8"?>
<testcase id="eira-001-the-model-is-eira-conformant"
          xmlns="http://www.gitb.com/tdl/v1/"
          xmlns:gitb="http://www.gitb.com/core/v1/">
  <metadata>
    <gitb:name>eira-001 the model is EIRA-conformant</gitb:name>
    <gitb:version>1.0</gitb:version>
    <gitb:description>EIRA alignment of the national eHealth exchange architecture</gitb:description>
  </metadata>

  <actors>
    <gitb:actor id="Architect" role="SUT"/>
    <gitb:actor id="ModelRepo" role="SIMULATED"/>
    <gitb:actor id="EiraValidator" role="SIMULATED"/>
  </actors>

  <variables>
    <var name="eiraBody" type="string"/>
    <var name="conformanceErrors" type="string"/>
    <var name="validationErrors" type="string"/>
    <var name="validationWarnings" type="string"/>
    <var name="lastRequest" type="map"/>
    <var name="ModelRepoBase" type="string"/>
    <var name="EiraValidatorBase" type="string"/>
    <var name="archiHeaders" type="map"/>
    <var name="model" type="string"/>
    <var name="eiraParams" type="map"/>
  </variables>

  <steps stopOnError="true">
    <assign to="ModelRepoBase">&quot;http://archi:8080&quot;</assign>
    <assign to="EiraValidatorBase">&quot;http://eira:8080&quot;</assign>
    <assign to="archiHeaders{Accept}">&quot;application/json&quot;</assign>
    <send id="lastRequest" desc="Load model ehealth-exchange" handler="HttpMessagingV2" from="Architect" to="ModelRepo">
      <input name="uri">concat($ModelRepoBase, &quot;/archimate/api/models/&quot;, &quot;ehealth-exchange&quot;)</input>
      <input name="method">&quot;GET&quot;</input>
      <input name="headers">$archiHeaders</input>
    </send>
    <verify handler="NumberValidator" desc="Model ehealth-exchange found (HTTP 200)">
      <input name="actualnumber">$lastRequest{response}{status}</input>
      <input name="expectednumber">&quot;200&quot;</input>
    </verify>
    <assign to="model">$lastRequest{response}{body}</assign>
    <assign to="archiHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="archiHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="eiraParams{content}">$model</assign>
    <assign to="eiraParams{profile}">&quot;https://eira.ec.europa.eu/eira/6.0&quot;</assign>
    <assign to="eiraParams{view}">&quot;Solution Architecture&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="eiraBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;input&quot;: [ { &quot;name&quot;: &quot;contentToValidate&quot;, &quot;value&quot;: &quot;${content?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;validationType&quot;, &quot;value&quot;: &quot;${profile?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }&lt;#if view?has_content&gt;, { &quot;name&quot;: &quot;view&quot;, &quot;value&quot;: &quot;${view?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }&lt;/#if&gt; ] }'</input>
      <input name="parameters">$eiraParams</input>
    </process>
    <send id="lastRequest" desc="Check $model against https://eira.ec.europa.eu/eira/6.0" handler="HttpMessagingV2" from="Architect" to="EiraValidator">
      <input name="uri">concat($EiraValidatorBase, &quot;/eira/api/validate&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$archiHeaders</input>
      <input name="body">$eiraBody</input>
    </send>
    <verify handler="NumberValidator" desc="EIRA validator answered (HTTP 200)">
      <input name="actualnumber">$lastRequest{response}{status}</input>
      <input name="expectednumber">&quot;200&quot;</input>
    </verify>
    <process handler="JsonPointerProcessor" operation="process" output="conformanceErrors">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/context/0/value&quot;</input>
    </process>
    <process handler="JsonPointerProcessor" operation="process" output="validationErrors">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/context/0/value&quot;</input>
    </process>
    <process handler="JsonPointerProcessor" operation="process" output="validationWarnings">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/context/1/value&quot;</input>
    </process>
    <verify handler="StringValidator" desc="$model conforms to https://eira.ec.europa.eu/eira/6.0">
      <input name="actualstring">$conformanceErrors</input>
      <input name="expectedstring">&quot;0&quot;</input>
    </verify>
  </steps>

  <output>
    <success>
      <default>"Test case completed successfully."</default>
    </success>
    <failure>
      <default>"Test case failed. Check step reports and logs."</default>
    </failure>
  </output>
</testcase>