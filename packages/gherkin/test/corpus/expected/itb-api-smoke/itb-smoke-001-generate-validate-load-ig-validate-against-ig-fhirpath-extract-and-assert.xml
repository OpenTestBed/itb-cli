<?xml version="1.0" encoding="UTF-8"?>
<testcase id="itb-smoke-001-generate-validate-load-ig-validate-against-ig-fhirpath-extract-and-assert"
          xmlns="http://www.gitb.com/tdl/v1/"
          xmlns:gitb="http://www.gitb.com/core/v1/">
  <metadata>
    <gitb:name>itb-smoke-001 Generate, validate, load IG, validate against IG, FHIRPath extract and assert</gitb:name>
    <gitb:version>1.0</gitb:version>
    <gitb:description>FHIR Validator ITB REST API smoke test</gitb:description>
  </metadata>

  <actors>
    <gitb:actor id="Client" role="SUT"/>
    <gitb:actor id="FHIRValidator" role="SIMULATED"/>
  </actors>

  <variables>
    <var name="loadIgBody" type="string"/>
    <var name="mappingsJson" type="string"/>
    <var name="generateBody" type="string"/>
    <var name="patient" type="string"/>
    <var name="allergy" type="string"/>
    <var name="validateBody" type="string"/>
    <var name="validationErrors" type="string"/>
    <var name="validationWarnings" type="string"/>
    <var name="validationSeverity" type="string"/>
    <var name="validationOutcome" type="string"/>
    <var name="fhirpathBody" type="string"/>
    <var name="patientId" type="string"/>
    <var name="fhirpathResult" type="string"/>
    <var name="matchBody" type="string"/>
    <var name="matchResult" type="string"/>
    <var name="assertBody" type="string"/>
    <var name="assertResult" type="string"/>
    <var name="summarizeBody" type="string"/>
    <var name="errCount" type="string"/>
    <var name="warnCount" type="string"/>
    <var name="infoCount" type="string"/>
    <var name="lastRequest" type="map"/>
    <var name="FHIRValidatorBase" type="string"/>
    <var name="fhirValidatorHeaders" type="map"/>
    <var name="loadIgTplParams" type="map"/>
    <var name="entryTplParams" type="map"/>
    <var name="closeTplParams" type="map"/>
    <var name="generateTplParams" type="map"/>
    <var name="validateTplParams" type="map"/>
    <var name="fhirpathTplParams" type="map"/>
    <var name="matchTplParams" type="map"/>
    <var name="assertTplParams" type="map"/>
    <var name="summarizeTplParams" type="map"/>
    <var name="string" type="string"/>
  </variables>

  <steps stopOnError="true">
    <assign to="FHIRValidatorBase">&quot;http://fhir-validator:8081&quot;</assign>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="loadIgTplParams{ig}">&quot;hl7.fhir.be.allergy#1.2.0&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="loadIgBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;loadIG&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;ig&quot;, &quot;value&quot;: &quot;${ig}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$loadIgTplParams</input>
    </process>
    <send id="lastRequest" desc="Load IG via IGManager" handler="HttpMessagingV2" from="Client" to="FHIRValidator">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/igManager/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$loadIgBody</input>
    </send>
    <verify handler="NumberValidator" desc="IGManager.loadIG returned HTTP 200">
      <input name="actualnumber">$lastRequest{response}{status}</input>
      <input name="expectednumber">&quot;200&quot;</input>
    </verify>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="mappingsJson">&quot;[&quot;</assign>
    <assign to="entryTplParams{path}">&quot;Patient.id&quot;</assign>
    <assign to="entryTplParams{value}">&quot;smoke-test-001&quot;</assign>
    <assign to="entryTplParams{system}">&quot;&quot;</assign>
    <assign to="entryTplParams{code}">&quot;&quot;</assign>
    <assign to="entryTplParams{accum}">$mappingsJson</assign>
    <process handler="TemplateProcessor" operation="process" output="mappingsJson">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'${accum}&lt;#if accum?ends_with(&quot;[&quot;)&gt;&lt;#else&gt;,&lt;/#if&gt;{&quot;path&quot;:&quot;${path}&quot;,&lt;#if value?has_content&gt;&quot;value&quot;:&quot;${value}&quot;&lt;#else&gt;&quot;parts&quot;:[{&quot;name&quot;:&quot;system&quot;,&quot;value&quot;:&quot;${system}&quot;},{&quot;name&quot;:&quot;code&quot;,&quot;value&quot;:&quot;${code}&quot;}]&lt;/#if&gt;}'</input>
      <input name="parameters">$entryTplParams</input>
    </process>
    <assign to="closeTplParams{accum}">$mappingsJson</assign>
    <process handler="TemplateProcessor" operation="process" output="mappingsJson">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'${accum}]'</input>
      <input name="parameters">$closeTplParams</input>
    </process>
    <assign to="generateTplParams{profile}">&quot;http://hl7.org/fhir/StructureDefinition/Patient&quot;</assign>
    <assign to="generateTplParams{mappings}">$mappingsJson</assign>
    <process handler="TemplateProcessor" operation="process" output="generateBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;generate&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;profile&quot;, &quot;value&quot;: &quot;${profile}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;requiredOnly&quot;, &quot;value&quot;: &quot;true&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;mappings&quot;, &quot;value&quot;: &quot;${mappings?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$generateTplParams</input>
    </process>
    <send id="lastRequest" desc="Generate required-only test data with values" handler="HttpMessagingV2" from="Client">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/testdata/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$generateBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="patient">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/output/0/value&quot;</input>
    </process>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="mappingsJson">&quot;[&quot;</assign>
    <assign to="entryTplParams{path}">&quot;AllergyIntolerance.code.coding&quot;</assign>
    <assign to="entryTplParams{value}">&quot;&quot;</assign>
    <assign to="entryTplParams{system}">&quot;http://snomed.info/sct&quot;</assign>
    <assign to="entryTplParams{code}">&quot;1232123&quot;</assign>
    <assign to="entryTplParams{accum}">$mappingsJson</assign>
    <process handler="TemplateProcessor" operation="process" output="mappingsJson">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'${accum}&lt;#if accum?ends_with(&quot;[&quot;)&gt;&lt;#else&gt;,&lt;/#if&gt;{&quot;path&quot;:&quot;${path}&quot;,&lt;#if value?has_content&gt;&quot;value&quot;:&quot;${value}&quot;&lt;#else&gt;&quot;parts&quot;:[{&quot;name&quot;:&quot;system&quot;,&quot;value&quot;:&quot;${system}&quot;},{&quot;name&quot;:&quot;code&quot;,&quot;value&quot;:&quot;${code}&quot;}]&lt;/#if&gt;}'</input>
      <input name="parameters">$entryTplParams</input>
    </process>
    <assign to="entryTplParams{path}">&quot;AllergyIntolerance.clinicalStatus.coding&quot;</assign>
    <assign to="entryTplParams{value}">&quot;&quot;</assign>
    <assign to="entryTplParams{system}">&quot;http://terminology.hl7.org/CodeSystem/allergyintolerance-clinical&quot;</assign>
    <assign to="entryTplParams{code}">&quot;active&quot;</assign>
    <assign to="entryTplParams{accum}">$mappingsJson</assign>
    <process handler="TemplateProcessor" operation="process" output="mappingsJson">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'${accum}&lt;#if accum?ends_with(&quot;[&quot;)&gt;&lt;#else&gt;,&lt;/#if&gt;{&quot;path&quot;:&quot;${path}&quot;,&lt;#if value?has_content&gt;&quot;value&quot;:&quot;${value}&quot;&lt;#else&gt;&quot;parts&quot;:[{&quot;name&quot;:&quot;system&quot;,&quot;value&quot;:&quot;${system}&quot;},{&quot;name&quot;:&quot;code&quot;,&quot;value&quot;:&quot;${code}&quot;}]&lt;/#if&gt;}'</input>
      <input name="parameters">$entryTplParams</input>
    </process>
    <assign to="closeTplParams{accum}">$mappingsJson</assign>
    <process handler="TemplateProcessor" operation="process" output="mappingsJson">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'${accum}]'</input>
      <input name="parameters">$closeTplParams</input>
    </process>
    <assign to="generateTplParams{profile}">&quot;https://www.ehealth.fgov.be/standards/fhir/allergy/StructureDefinition/be-allergyintolerance&quot;</assign>
    <assign to="generateTplParams{mappings}">$mappingsJson</assign>
    <process handler="TemplateProcessor" operation="process" output="generateBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;generate&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;profile&quot;, &quot;value&quot;: &quot;${profile}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;requiredOnly&quot;, &quot;value&quot;: &quot;true&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;mappings&quot;, &quot;value&quot;: &quot;${mappings?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$generateTplParams</input>
    </process>
    <send id="lastRequest" desc="Generate required-only test data with values" handler="HttpMessagingV2" from="Client">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/testdata/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$generateBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="allergy">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/output/0/value&quot;</input>
    </process>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="validateTplParams{resource}">$patient</assign>
    <assign to="validateTplParams{resourceType}">&quot;Patient&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="validateBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;input&quot;: [ { &quot;name&quot;: &quot;contentToValidate&quot;, &quot;value&quot;: &quot;${resource?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;profiles&quot;, &quot;value&quot;: &quot;http://hl7.org/fhir/StructureDefinition/${resourceType}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$validateTplParams</input>
    </process>
    <send id="lastRequest" desc="Validate against base FHIR profile for Patient" handler="HttpMessagingV2" from="Client">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/fhir/validate&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$validateBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="validationErrors">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/context/0/value&quot;</input>
    </process>
    <verify handler="StringValidator" desc="patient is a valid Patient resource">
      <input name="actualstring">$validationErrors</input>
      <input name="expectedstring">&quot;0&quot;</input>
    </verify>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="validateTplParams{resource}">$allergy</assign>
    <assign to="validateTplParams{profiles}">&quot;https://www.ehealth.fgov.be/standards/fhir/allergy/StructureDefinition/be-allergyintolerance&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="validateBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;input&quot;: [ { &quot;name&quot;: &quot;contentToValidate&quot;, &quot;value&quot;: &quot;${resource?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;profiles&quot;, &quot;value&quot;: &quot;${profiles}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$validateTplParams</input>
    </process>
    <send id="lastRequest" desc="Validate resource against profile" handler="HttpMessagingV2" from="Client">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/fhir/validate&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$validateBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="validationErrors">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/context/0/value&quot;</input>
    </process>
    <process handler="JsonPointerProcessor" operation="process" output="validationWarnings">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/context/1/value&quot;</input>
    </process>
    <process handler="JsonPointerProcessor" operation="process" output="validationSeverity">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/context/3/value&quot;</input>
    </process>
    <process handler="JsonPointerProcessor" operation="process" output="validationOutcome">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/context/4/value&quot;</input>
    </process>
    <verify handler="StringValidator" desc="No validation errors">
      <input name="actualstring">$validationErrors</input>
      <input name="expectedstring">&quot;0&quot;</input>
    </verify>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="fhirpathTplParams{resource}">$patient</assign>
    <assign to="fhirpathTplParams{expression}">&quot;Patient.id&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="fhirpathBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;evaluate&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;content&quot;, &quot;value&quot;: &quot;${resource?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;expression&quot;, &quot;value&quot;: &quot;${expression?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$fhirpathTplParams</input>
    </process>
    <send id="lastRequest" desc="Evaluate FHIRPath expression" handler="HttpMessagingV2" from="Client">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/fhirPath/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$fhirpathBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="patientId">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/output/0/value&quot;</input>
    </process>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="fhirpathTplParams{resource}">$patient</assign>
    <assign to="fhirpathTplParams{expression}">&quot;Patient.id.exists()&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="fhirpathBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;evaluate&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;content&quot;, &quot;value&quot;: &quot;${resource?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;expression&quot;, &quot;value&quot;: &quot;${expression?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$fhirpathTplParams</input>
    </process>
    <send id="lastRequest" desc="Evaluate FHIRPath expression" handler="HttpMessagingV2" from="Client">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/fhirPath/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$fhirpathBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="fhirpathResult">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/output/0/value&quot;</input>
    </process>
    <verify handler="StringValidator" desc="FHIRPath result matches expected value">
      <input name="actualstring">$fhirpathResult</input>
      <input name="expectedstring">&quot;true&quot;</input>
    </verify>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="matchTplParams{resource}">$patient</assign>
    <assign to="matchTplParams{matchetype}">'{&quot;resourceType&quot;: &quot;Patient&quot;, &quot;id&quot;: &quot;$string$&quot;}'</assign>
    <process handler="TemplateProcessor" operation="process" output="matchBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;input&quot;: [ { &quot;name&quot;: &quot;contentToValidate&quot;, &quot;value&quot;: &quot;${resource?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;matchetype&quot;, &quot;value&quot;: &quot;${matchetype?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$matchTplParams</input>
    </process>
    <send id="lastRequest" desc="Matchetype validate" handler="HttpMessagingV2" from="Client">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/matchetype/validate&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$matchBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="matchResult">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/result&quot;</input>
    </process>
    <verify handler="StringValidator" desc="Matchetype comparison succeeded">
      <input name="actualstring">$matchResult</input>
      <input name="expectedstring">&quot;SUCCESS&quot;</input>
    </verify>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="assertTplParams{resource}">$patient</assign>
    <assign to="assertTplParams{expression}">&quot;Patient.id.exists()&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="assertBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;input&quot;: [ { &quot;name&quot;: &quot;contentToValidate&quot;, &quot;value&quot;: &quot;${resource?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;expression&quot;, &quot;value&quot;: &quot;${expression?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$assertTplParams</input>
    </process>
    <send id="lastRequest" desc="FHIRPath assertion" handler="HttpMessagingV2" from="Client">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/fhirPathAssertion/validate&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$assertBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="assertResult">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/result&quot;</input>
    </process>
    <verify handler="StringValidator" desc="FHIRPath assertion succeeded">
      <input name="actualstring">$assertResult</input>
      <input name="expectedstring">&quot;SUCCESS&quot;</input>
    </verify>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="summarizeTplParams{outcome}">$validationOutcome</assign>
    <process handler="TemplateProcessor" operation="process" output="summarizeBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;summarize&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;outcome&quot;, &quot;value&quot;: &quot;${outcome?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$summarizeTplParams</input>
    </process>
    <send id="lastRequest" desc="Summarize OperationOutcome" handler="HttpMessagingV2" from="Client">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/validationResults/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$summarizeBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="errCount">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/output/0/value&quot;</input>
    </process>
    <process handler="JsonPointerProcessor" operation="process" output="warnCount">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/output/1/value&quot;</input>
    </process>
    <process handler="JsonPointerProcessor" operation="process" output="infoCount">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/output/2/value&quot;</input>
    </process>
  </steps>

  <output>
    <success>
      <default>"Test case completed successfully."</default>
    </success>
    <failure>
      <default>"Test case failed. Check step reports and logs."</default>
    </failure>
  </output>
</testcase>