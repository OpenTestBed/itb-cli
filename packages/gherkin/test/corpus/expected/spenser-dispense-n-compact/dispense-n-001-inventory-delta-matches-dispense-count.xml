<?xml version="1.0" encoding="UTF-8"?>
<testcase id="dispense-n-001-inventory-delta-matches-dispense-count"
          xmlns="http://www.gitb.com/tdl/v1/"
          xmlns:gitb="http://www.gitb.com/core/v1/">
  <metadata>
    <gitb:name>dispense-N-001 inventory delta matches dispense count</gitb:name>
    <gitb:version>1.0</gitb:version>
    <gitb:description>Spenser dispenses N dark chocolates and inventory drops by N</gitb:description>
  </metadata>

  <actors>
    <gitb:actor id="Spenser" role="SUT"/>
    <gitb:actor id="FHIRValidator" role="SIMULATED"/>
    <gitb:actor id="Client" role="SIMULATED"/>
  </actors>

  <variables>
    <var name="N" type="string"/>
    <var name="loadIgBody" type="string"/>
    <var name="X" type="string"/>
    <var name="mappingsJson" type="string"/>
    <var name="generateBody" type="string"/>
    <var name="darkOrder" type="string"/>
    <var name="conformBody" type="string"/>
    <var name="validationErrors" type="string"/>
    <var name="validationWarnings" type="string"/>
    <var name="validationSeverity" type="string"/>
    <var name="validationOutcome" type="string"/>
    <var name="Y" type="string"/>
    <var name="lastRequest" type="map"/>
    <var name="SpenserBase" type="string"/>
    <var name="FHIRValidatorBase" type="string"/>
    <var name="fhirValidatorHeaders" type="map"/>
    <var name="loadIgTplParams" type="map"/>
    <var name="jsonHeaders" type="map"/>
    <var name="before" type="string"/>
    <var name="sigStatus" type="string"/>
    <var name="entryTplParams" type="map"/>
    <var name="closeTplParams" type="map"/>
    <var name="generateTplParams" type="map"/>
    <var name="conformHeaders" type="map"/>
    <var name="conformTplParams" type="map"/>
    <var name="conformanceErrors" type="string"/>
    <var name="i" type="string">
      <value>0</value>
    </var>
    <var name="after" type="string"/>
  </variables>

  <steps stopOnError="true">
    <assign to="SpenserBase">&quot;http://spenser.local&quot;</assign>
    <assign to="FHIRValidatorBase">&quot;http://fhir-validator:8081&quot;</assign>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="loadIgTplParams{ig}">&quot;jct.fhir.spenser#1.0.0&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="loadIgBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;loadIG&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;ig&quot;, &quot;value&quot;: &quot;${ig?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$loadIgTplParams</input>
    </process>
    <send id="lastRequest" desc="Load IG jct.fhir.spenser#1.0.0" handler="HttpMessagingV2" from="Spenser" to="FHIRValidator">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/igManager/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$loadIgBody</input>
    </send>
    <verify handler="NumberValidator" desc="IG jct.fhir.spenser#1.0.0 loaded (HTTP 200)">
      <input name="actualnumber">$lastRequest{response}{status}</input>
      <input name="expectednumber">&quot;200&quot;</input>
    </verify>
    <interact id="ask" desc="How many dark chocolates to dispense?" inputTitle="How many dark chocolates to dispense?">
      <request desc="How many dark chocolates to dispense?" name="N" inputType="TEXT" required="true">$N</request>
    </interact>
    <assign to="jsonHeaders{Accept}">&quot;application/json&quot;</assign>
    <send id="lastRequest" desc="GET /InventoryReport" handler="HttpMessagingV2" from="Client" to="Spenser">
      <input name="uri">concat($SpenserBase, &quot;/InventoryReport&quot;)</input>
      <input name="method">&quot;GET&quot;</input>
      <input name="headers">$jsonHeaders</input>
    </send>
    <assign to="before">$lastRequest{response}{body}</assign>
    <assign to="sigStatus">if (empty($lastRequest{response}{status})) then &quot;0&quot; else $lastRequest{response}{status}</assign>
    <verify handler="NumberValidator" desc="Response status is 200">
      <input name="actualnumber">$sigStatus</input>
      <input name="expectednumber">&quot;200&quot;</input>
    </verify>
    <process handler="JsonPointerProcessor" operation="process" output="X">
      <input name="content">$before</input>
      <input name="pointer">&quot;/inventoryListing/0/item/0/quantity/value&quot;</input>
    </process>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="mappingsJson">&quot;[&quot;</assign>
    <assign to="entryTplParams{path}">&quot;MedicationRequest.id&quot;</assign>
    <assign to="entryTplParams{value}">&quot;dispense-test&quot;</assign>
    <assign to="entryTplParams{system}">&quot;&quot;</assign>
    <assign to="entryTplParams{code}">&quot;&quot;</assign>
    <assign to="entryTplParams{accum}">$mappingsJson</assign>
    <process handler="TemplateProcessor" operation="process" output="mappingsJson">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'${accum}&lt;#if accum?ends_with(&quot;[&quot;)&gt;&lt;#else&gt;,&lt;/#if&gt;{&quot;path&quot;:&quot;${path}&quot;,&lt;#if value?has_content&gt;&quot;value&quot;:&quot;${value}&quot;&lt;#else&gt;&quot;parts&quot;:[{&quot;name&quot;:&quot;system&quot;,&quot;value&quot;:&quot;${system}&quot;},{&quot;name&quot;:&quot;code&quot;,&quot;value&quot;:&quot;${code}&quot;}]&lt;/#if&gt;}'</input>
      <input name="parameters">$entryTplParams</input>
    </process>
    <assign to="entryTplParams{path}">&quot;MedicationRequest.subject.reference&quot;</assign>
    <assign to="entryTplParams{value}">&quot;Patient/dispense-test&quot;</assign>
    <assign to="entryTplParams{system}">&quot;&quot;</assign>
    <assign to="entryTplParams{code}">&quot;&quot;</assign>
    <assign to="entryTplParams{accum}">$mappingsJson</assign>
    <process handler="TemplateProcessor" operation="process" output="mappingsJson">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'${accum}&lt;#if accum?ends_with(&quot;[&quot;)&gt;&lt;#else&gt;,&lt;/#if&gt;{&quot;path&quot;:&quot;${path}&quot;,&lt;#if value?has_content&gt;&quot;value&quot;:&quot;${value}&quot;&lt;#else&gt;&quot;parts&quot;:[{&quot;name&quot;:&quot;system&quot;,&quot;value&quot;:&quot;${system}&quot;},{&quot;name&quot;:&quot;code&quot;,&quot;value&quot;:&quot;${code}&quot;}]&lt;/#if&gt;}'</input>
      <input name="parameters">$entryTplParams</input>
    </process>
    <assign to="entryTplParams{path}">&quot;MedicationRequest.medication.concept.coding&quot;</assign>
    <assign to="entryTplParams{value}">&quot;&quot;</assign>
    <assign to="entryTplParams{system}">&quot;http://costateixeira.github.io/spenser/CodeSystem/SpenserMeds&quot;</assign>
    <assign to="entryTplParams{code}">&quot;chocolate-dark&quot;</assign>
    <assign to="entryTplParams{accum}">$mappingsJson</assign>
    <process handler="TemplateProcessor" operation="process" output="mappingsJson">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'${accum}&lt;#if accum?ends_with(&quot;[&quot;)&gt;&lt;#else&gt;,&lt;/#if&gt;{&quot;path&quot;:&quot;${path}&quot;,&lt;#if value?has_content&gt;&quot;value&quot;:&quot;${value}&quot;&lt;#else&gt;&quot;parts&quot;:[{&quot;name&quot;:&quot;system&quot;,&quot;value&quot;:&quot;${system}&quot;},{&quot;name&quot;:&quot;code&quot;,&quot;value&quot;:&quot;${code}&quot;}]&lt;/#if&gt;}'</input>
      <input name="parameters">$entryTplParams</input>
    </process>
    <assign to="closeTplParams{accum}">$mappingsJson</assign>
    <process handler="TemplateProcessor" operation="process" output="mappingsJson">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'${accum}]'</input>
      <input name="parameters">$closeTplParams</input>
    </process>
    <assign to="generateTplParams{profile}">&quot;http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest&quot;</assign>
    <assign to="generateTplParams{mappings}">$mappingsJson</assign>
    <process handler="TemplateProcessor" operation="process" output="generateBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;generate&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;profile&quot;, &quot;value&quot;: &quot;${profile}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;requiredOnly&quot;, &quot;value&quot;: &quot;true&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;mappings&quot;, &quot;value&quot;: &quot;${mappings?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$generateTplParams</input>
    </process>
    <send id="lastRequest" desc="Generate required-only test data with values" handler="HttpMessagingV2" from="Spenser" to="FHIRValidator">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/testdata/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$generateBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="darkOrder">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/output/0/value&quot;</input>
    </process>
    <assign to="conformHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="conformHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="conformTplParams{resource}">$darkOrder</assign>
    <assign to="conformTplParams{profile}">&quot;http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="conformBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;input&quot;: [ { &quot;name&quot;: &quot;contentToValidate&quot;, &quot;value&quot;: &quot;${resource?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;profiles&quot;, &quot;value&quot;: &quot;${profile?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$conformTplParams</input>
    </process>
    <send id="lastRequest" desc="Validate $darkOrder against http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest" handler="HttpMessagingV2" from="Spenser" to="FHIRValidator">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/fhir/validate&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$conformHeaders</input>
      <input name="body">$conformBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="validationErrors">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/context/0/value&quot;</input>
    </process>
    <process handler="JsonPointerProcessor" operation="process" output="validationWarnings">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/context/1/value&quot;</input>
    </process>
    <process handler="JsonPointerProcessor" operation="process" output="validationSeverity">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/context/3/value&quot;</input>
    </process>
    <process handler="JsonPointerProcessor" operation="process" output="validationOutcome">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/context/4/value&quot;</input>
    </process>
    <assign to="conformanceErrors">$validationErrors</assign>
    <verify handler="StringValidator" desc="$darkOrder conforms to http://costateixeira.github.io/spenser/StructureDefinition/SpenserRequest">
      <input name="actualstring">$conformanceErrors</input>
      <input name="expectedstring">&quot;0&quot;</input>
    </verify>
    <assign to="jsonHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="jsonHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="i">0</assign>
    <while>
      <cond>number($i) &lt; number($N)</cond>
      <do>
        <send id="lastRequest" desc="POST /MedicationRequest (loop)" handler="HttpMessagingV2" from="Client" to="Spenser">
          <input name="uri">concat($SpenserBase, &quot;/MedicationRequest&quot;)</input>
          <input name="method">&quot;POST&quot;</input>
          <input name="headers">$jsonHeaders</input>
          <input name="body">$darkOrder</input>
        </send>
        <call path="scriptlets/instructUser.xml">
          <input name="step">&quot;inform&quot;</input>
          <input name="actor">&quot;Client&quot;</input>
          <input name="message">&quot;Dispense in progress — click Continue when the device finishes and is ready for the next request.&quot;</input>
        </call>
        <assign to="i">number($i) + 1</assign>
      </do>
    </while>
    <assign to="jsonHeaders{Accept}">&quot;application/json&quot;</assign>
    <send id="lastRequest" desc="GET /InventoryReport" handler="HttpMessagingV2" from="Client" to="Spenser">
      <input name="uri">concat($SpenserBase, &quot;/InventoryReport&quot;)</input>
      <input name="method">&quot;GET&quot;</input>
      <input name="headers">$jsonHeaders</input>
    </send>
    <assign to="after">$lastRequest{response}{body}</assign>
    <assign to="sigStatus">if (empty($lastRequest{response}{status})) then &quot;0&quot; else $lastRequest{response}{status}</assign>
    <verify handler="NumberValidator" desc="Response status is 200">
      <input name="actualnumber">$sigStatus</input>
      <input name="expectednumber">&quot;200&quot;</input>
    </verify>
    <process handler="JsonPointerProcessor" operation="process" output="Y">
      <input name="content">$after</input>
      <input name="pointer">&quot;/inventoryListing/0/item/0/quantity/value&quot;</input>
    </process>
    <verify handler="ExpressionValidator" desc="$Y = X - N">
      <input name="expression">number($Y) = number($X) - number($N)</input>
    </verify>
  </steps>

  <output>
    <success>
      <default>"Test case completed successfully."</default>
    </success>
    <failure>
      <default>"Test case failed. Check step reports and logs."</default>
    </failure>
  </output>
</testcase>