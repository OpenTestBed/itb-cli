<?xml version="1.0" encoding="UTF-8"?>
<testsuite id="ihe-mhd-document-source-ch-mhd-1-update-is-well-formed"
           xmlns="http://www.gitb.com/tdl/v1/"
           xmlns:gitb="http://www.gitb.com/core/v1/">
  <metadata>
    <gitb:name>IHE MHD Document Source — CH:MHD-1 update is well formed</gitb:name>
    <gitb:version>1.0</gitb:version>
    <gitb:description>The SUT is a Document Source. ITB plays the Responder: it accepts the update the SUT sends, checks the request against CH:MHD-1, and answers.</gitb:description>
  </metadata>

  <actors>
    <gitb:actor id="DocumentSource">
      <gitb:name>DocumentSource</gitb:name>
      <gitb:desc>Definition: https://profiles.ihe.net/ITI/MHD/StructureDefinition/IHE.MHD.DocumentSource</gitb:desc>
    </gitb:actor>
    <gitb:actor id="DocumentResponder">
      <gitb:name>DocumentResponder</gitb:name>
      <gitb:desc>Definition: https://profiles.ihe.net/ITI/MHD/StructureDefinition/IHE.MHD.DocumentResponder</gitb:desc>
    </gitb:actor>
    <gitb:actor id="FHIRValidator">
      <gitb:name>FHIRValidator</gitb:name>
      <gitb:desc>Endpoint: http://fhir-validator:8081</gitb:desc>
    </gitb:actor>
  </actors>

  <testcase id="mhd-src-001-the-sut-sends-a-conformant-ch-mhd-1-update"/>

</testsuite>