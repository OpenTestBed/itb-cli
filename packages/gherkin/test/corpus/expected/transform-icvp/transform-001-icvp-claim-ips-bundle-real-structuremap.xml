    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="transformTplParams{content}">$icvpClaim</assign>
    <assign to="transformTplParams{map}">&quot;http://smart.who.int/icvp/StructureMap/ICVPClaimtoIPS&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="transformBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;operation&quot;: &quot;transform&quot;, &quot;input&quot;: [ { &quot;name&quot;: &quot;content&quot;, &quot;value&quot;: &quot;${content?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;map&quot;, &quot;value&quot;: &quot;${map}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;contentType&quot;, &quot;value&quot;: &quot;application/fhir+json&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;targetFormat&quot;, &quot;value&quot;: &quot;json&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$transformTplParams</input>
    </process>
    <send id="lastRequest" desc="Apply StructureMap transformation" handler="HttpMessagingV2" from="Client">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/transform/process&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$transformBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="ipsBundle">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/output/0/value&quot;</input>
    </process>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="assertTplParams{resource}">$ipsBundle</assign>
    <assign to="assertTplParams{expression}">&quot;Bundle.type = 'document'&quot;</assign>
    <process handler="TemplateProcessor" operation="process" output="assertBody">
      <input name="syntax">&quot;freemarker&quot;</input>
      <input name="template">'{ &quot;input&quot;: [ { &quot;name&quot;: &quot;contentToValidate&quot;, &quot;value&quot;: &quot;${resource?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; }, { &quot;name&quot;: &quot;expression&quot;, &quot;value&quot;: &quot;${expression?json_string}&quot;, &quot;embeddingMethod&quot;: &quot;STRING&quot; } ] }'</input>
      <input name="parameters">$assertTplParams</input>
    </process>
    <send id="lastRequest" desc="FHIRPath assertion" handler="HttpMessagingV2" from="Client">
      <input name="uri">concat($FHIRValidatorBase, &quot;/itb/fhirPathAssertion/validate&quot;)</input>
      <input name="method">&quot;POST&quot;</input>
      <input name="headers">$fhirValidatorHeaders</input>
      <input name="body">$assertBody</input>
    </send>
    <process handler="JsonPointerProcessor" operation="process" output="assertResult">
      <input name="content">$lastRequest{response}{body}</input>
      <input name="pointer">&quot;/report/result&quot;</input>
    </process>
    <verify handler="StringValidator" desc="FHIRPath assertion succeeded">
      <input name="actualstring">$assertResult</input>
      <input name="expectedstring">&quot;SUCCESS&quot;</input>
    </verify>
    <assign to="fhirValidatorHeaders{Content-Type}">&quot;application/json&quot;</assign>
    <assign to="fhirValidatorHeaders{Accept}">&quot;application/json&quot;</assign>
    <assign to="assertTplParams{resource}">$ipsBundle</assign>
    <assign to="assertTplParams{expression}">&quot;Bundle.entry.resource.ofType(Patient).name.text.first() = 'Cristina Rodriguez'&quot;</assign>
