{
  "name": "@opentestbed/otb-gherkin",
  "version": "0.0.0",
  "description": "Gherkin -> GITB TDL compiler: the FHIR Gherkin dialect, its parser and its XML generator",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lang/en.yml": "./lang/en.yml"
  },
  "files": [
    "dist",
    "lang"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node test/corpus.mjs",
    "test:update": "node test/corpus.mjs --update",
    "prepare": "npm run build"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
