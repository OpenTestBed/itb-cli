{
  "name": "@opentestbed/otb-gherkin",
  "version": "0.1.0",
  "description": "Gherkin -> GITB TDL compiler: the FHIR Gherkin dialect, its parser and its XML generator",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lang/en.yml": "./lang/en.yml",
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "lang",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node test/corpus.mjs",
    "test:update": "node test/corpus.mjs --update",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "gherkin",
    "gitb",
    "tdl",
    "itb",
    "fhir",
    "conformance",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenTestBed/otb.git",
    "directory": "packages/gherkin"
  },
  "bugs": {
    "url": "https://github.com/OpenTestBed/otb/issues"
  },
  "homepage": "https://github.com/OpenTestBed/otb/tree/main/packages/gherkin#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
